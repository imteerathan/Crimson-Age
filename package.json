{
  "name": "crimson-atlas-horizon",
  "version": "0.4.0",
  "description": "Crimson Atlas Horizon desktop extension",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win --x64 --config.win.target=portable",
    "build:dir": "electron-builder --win --x64 --dir",
    "release": "electron-builder --win --x64 --publish always"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.crimsonatlas.horizon",
    "productName": "Crimson Atlas Horizon",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Crimson-Age-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "imteerathan",
      "repo": "Crimson-Age",
      "releaseType": "release"
    },
    "nsis": {
      "artifactName": "Crimson-Atlas-Horizon-Setup-${version}.${ext}"
    },
    "artifactName": "Crimson-Atlas-Horizon-${version}.${ext}"
  }
}
